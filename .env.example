# Copie para .env.local e preencha. Sem as duas primeiras, o app roda só no navegador, sem login.
VITE_SUPABASE_URL=https://dxgzyvkmuplhpgbezunm.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...). É pública, pode ir no front.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: Client ID do Google (Google Cloud → Clientes). Sem ele, "Entrar com Google" usa o redirect.
VITE_GOOGLE_CLIENT_ID=
# Opcional: domínios do app publicados, separados por vírgula (ex.: nishios.vercel.app), para o popup do Google.
VITE_APP_HOSTS=
